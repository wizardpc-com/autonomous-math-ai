include LICENSE README.md README.zh-CN.md
include CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md CITATION.cff
recursive-include src/autonomous_math_research/resources *.json *.md *.py
recursive-include templates/minimal-project *.json *.md
recursive-include docs *.md *.json
recursive-include scripts *.py
recursive-include tests *.py *.json
prune tests/_runtime
prune build
prune dist
prune **/__pycache__
global-exclude *.py[cod]
global-exclude .env *.pem *.key
