{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "exact_statement", "scope_ids", "claim_ids",
    "representation_id", "dependencies", "classification", "conclusion",
    "maturity_level", "proof_refs", "certificate_refs", "source_refs", "audit",
    "provenance", "supersedes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "result_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
    "exact_statement": {"type": "string", "minLength": 1},
    "scope_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "representation_id": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "classification": {"enum": ["AUDITED_EXTERNAL_RESULT", "UNAUDITED_EXTERNAL_RESULT", "COMPUTATION_ONLY", "CONFLICTING_RESULT"]},
    "conclusion": {"enum": ["PROVED", "REFUTED", "INCONCLUSIVE", "COMPUTATION", "KILL_GATE"]},
    "maturity_level": {"enum": ["RESULT", "THEME", "FINAL"]},
    "proof_refs": {"$ref": "#/$defs/evidenceRefs"},
    "certificate_refs": {"$ref": "#/$defs/evidenceRefs"},
    "source_refs": {"$ref": "#/$defs/evidenceRefs"},
    "audit": {"$ref": "#/$defs/audit"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "independent", "auditor", "audit_level", "policy_version", "report_refs", "reuse_audit_key"],
      "properties": {
        "verdict": {"type": ["string", "null"], "enum": ["PASS", "REJECT", "UNRESOLVED", null]},
        "independent": {"type": "boolean"},
        "auditor": {"type": ["string", "null"]},
        "audit_level": {"enum": ["RESULT", "THEME_INTEGRATION", "GLOBAL"]},
        "policy_version": {"type": "string", "minLength": 1},
        "report_refs": {"$ref": "#/$defs/evidenceRefs"},
        "reuse_audit_key": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "origin", "produced_at", "lineage"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "produced_at": {"type": "string", "minLength": 1},
        "lineage": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
