    "dependency_blocks": {"type": "integer"},
    "representation_blocks": {"type": "integer"},
    "budget_rejections": {"type": "integer"},
    "assets_retrieved": {"type": "integer"},
    "assets_loaded": {"type": "integer"},
    "assets_used": {"type": "integer"},
    "assets_cited_in_results": {"type": "integer"},
    "new_assets": {"type": "integer"},
    "audits_requested": {"type": "integer"},
    "audit_cache_hits": {"type": "integer"},
