{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment", "spawn", "audit_priorities", "route_updates", "short_rationale"],
  "properties": {
    "assessment": {"type": "string"},
    "spawn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "role", "target_claim", "exact_objective", "why_now", "dependencies", "expected_information_gain", "mathematical_impact", "estimated_cost_tier", "required_files", "stop_conditions", "priority", "route_family", "modifies_code", "metadata", "representation"],
        "properties": {
          "task_id": {"type": "string"},
          "role": {"type": "string", "enum": ["prover", "falsifier", "explorer"]},
          "target_claim": {"type": "string"},
          "exact_objective": {"type": "string"},
          "why_now": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "expected_information_gain": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
          "mathematical_impact": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "estimated_cost_tier": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
          "required_files": {"type": "array", "items": {"type": "string"}},
          "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "priority": {"type": "number", "minimum": 0, "maximum": 1},
          "route_family": {"type": "string"},
          "modifies_code": {"type": "boolean"},
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allow_derived_claims"],
            "properties": {"allow_derived_claims": {"type": "boolean"}}
          },
          "representation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["branch", "localization", "saturation", "normalization", "content", "exceptional_factors", "combination_scope"],
            "properties": {
              "branch": {"type": "string"},
              "localization": {"type": "string"},
              "saturation": {"type": "string"},
              "normalization": {"type": "string"},
              "content": {"type": "string"},
              "exceptional_factors": {"type": "array", "items": {"type": "string"}},
              "combination_scope": {"type": "string"}
            }
          }
        }
      }
    },
    "audit_priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_fingerprint", "priority", "reason"],
        "properties": {
          "candidate_fingerprint": {"type": "string"},
          "priority": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"}
        }
      }
    },
    "route_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "action", "reason", "retry_condition"],
        "properties": {
          "route_id": {"type": "string"},
          "action": {"type": "string", "enum": ["OPEN", "PAUSE", "RESUME", "RETRY"]},
          "reason": {"type": "string"},
          "retry_condition": {"type": ["string", "null"]}
        }
      }
    },
    "short_rationale": {"type": "string"}
  }
}
