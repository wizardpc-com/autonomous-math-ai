      "auditor": {"provider": "codex", "model": "gpt-6-astra", "effort": "xhigh", "unsupported_effort": "error"},
      "evaluator_auditor": {"provider": "codex", "model": "gpt-6-astra", "effort": "xhigh", "unsupported_effort": "error"},
