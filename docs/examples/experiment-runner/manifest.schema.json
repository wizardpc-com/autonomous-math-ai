{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-math-ai/experiment-manifest.schema.json",
  "title": "Experiment Runner manifest schema v1 (documentation companion)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "protocol_version",
    "adapter",
    "timeout_seconds",
    "inputs",
    "config",
    "versions",
    "resource_metadata",
    "cost_metadata",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"$ref": "#/$defs/identifier"},
    "protocol_version": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "config"],
      "properties": {
        "kind": {"enum": ["subprocess", "docker"]},
        "config": {"type": "object"}
      }
    },
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/portablePath"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "config": {"type": "object"},
    "versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "resource_metadata": {"type": "object"},
    "cost_metadata": {"type": "object"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "argv", "cwd"],
        "properties": {
          "case_id": {"$ref": "#/$defs/identifier"},
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "cwd": {"$ref": "#/$defs/portablePath"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\\\u0000]+$"
    }
  }
}
